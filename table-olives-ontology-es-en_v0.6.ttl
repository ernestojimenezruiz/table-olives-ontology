                                                                                   owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                       owl:onDatatype xsd:integer ;
                                                                                                       owl:withRestrictions ( [ xsd:minInclusive 561
                                                                                                                              ]
                                                                                                                              [ xsd:maxInclusive 610
                                                                                                                              ]
                                                                                                                            )
                                                                                                     ]
                                                                                 ]
                                                                               ) ;
                                                            rdf:type owl:Class
                                                          ] ;
                                      rdfs:label "Calibre entre 561 y 610"@es .


