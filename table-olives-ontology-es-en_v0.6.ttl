@prefix : <http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix table-olives-ontology: <http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#> .
@base <http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#> .

<http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl> rdf:type owl:Ontology ;
                                                                                 dc:creator "Ernesto Jiménez Ruiz" ;
                                                                                 dc:date "10/10/2010"^^xsd:date ;
                                                                                 rdfs:comment "Esta ontología ha sido creada siguiendo la Norma del CODEX para las Aceitunas de Mesa (CODEX STAN 66-1981)" ;
                                                                                 owl:versionInfo "v.0.6" .

#################################################################
#    Annotation properties
#################################################################

###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#synonym
table-olives-ontology:synonym rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#realizaTarea
table-olives-ontology:realizaTarea rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdfs:domain table-olives-ontology:Actor ;
                                   rdfs:range table-olives-ontology:Operacion .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#referidoTipoAceituna
table-olives-ontology:referidoTipoAceituna rdf:type owl:ObjectProperty ;
                                           rdfs:subPropertyOf owl:topObjectProperty ;
                                           rdfs:range table-olives-ontology:Tipo_Aceituna .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneCalibre
table-olives-ontology:tieneCalibre rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf owl:topObjectProperty ;
                                   rdfs:range table-olives-ontology:Calibrado .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneCategoria
table-olives-ontology:tieneCategoria rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf owl:topObjectProperty ;
                                     rdfs:domain table-olives-ontology:Producto ;
                                     rdfs:range table-olives-ontology:Categoria_Producto .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneColor
table-olives-ontology:tieneColor rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdfs:range table-olives-ontology:Color_Aceituna .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneEtapaRecogida
table-olives-ontology:tieneEtapaRecogida rdf:type owl:ObjectProperty ;
                                         rdfs:subPropertyOf owl:topObjectProperty ;
                                         rdfs:range table-olives-ontology:Etapa_Maduracion .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneFermentacion
table-olives-ontology:tieneFermentacion rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf owl:topObjectProperty ;
                                        rdfs:range table-olives-ontology:Fermentacion .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneParte
table-olives-ontology:tieneParte rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 rdfs:range table-olives-ontology:Partes_Aceituna .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tienePresentacion
table-olives-ontology:tienePresentacion rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf owl:topObjectProperty ;
                                        rdfs:domain table-olives-ontology:Producto ;
                                        rdfs:range table-olives-ontology:Presentacion_Aceituna .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneTipoAceituna
table-olives-ontology:tieneTipoAceituna rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf owl:topObjectProperty ;
                                        rdfs:range table-olives-ontology:Tipo_Aceituna .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneTipoConservacion
table-olives-ontology:tieneTipoConservacion rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf owl:topObjectProperty ;
                                            rdfs:range table-olives-ontology:Procesos_Conservacion .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneToleranciaDefectos
table-olives-ontology:tieneToleranciaDefectos rdf:type owl:ObjectProperty ;
                                              rdfs:subPropertyOf owl:topObjectProperty .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneTratamiento
table-olives-ontology:tieneTratamiento rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf owl:topObjectProperty ;
                                       rdfs:range table-olives-ontology:Tratamiento .


###  http://www.w3.org/2002/07/owl#topObjectProperty
owl:topObjectProperty rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneColoracionAnormal
table-olives-ontology:tieneColoracionAnormal rdf:type owl:DatatypeProperty ;
                                             rdfs:subPropertyOf table-olives-ontology:tieneDefectos ;
                                             rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneDanyosDacusOleae
table-olives-ontology:tieneDanyosDacusOleae rdf:type owl:DatatypeProperty ;
                                            rdfs:subPropertyOf table-olives-ontology:tieneDanyosInsectos ;
                                            rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneDanyosHongos
table-olives-ontology:tieneDanyosHongos rdf:type owl:DatatypeProperty ;
                                        rdfs:subPropertyOf table-olives-ontology:tieneDefectos ;
                                        rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneDanyosInsectos
table-olives-ontology:tieneDanyosInsectos rdf:type owl:DatatypeProperty ;
                                          rdfs:subPropertyOf table-olives-ontology:tieneDefectos ;
                                          rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneDefectos
table-olives-ontology:tieneDefectos rdf:type owl:DatatypeProperty ;
                                    rdfs:subPropertyOf owl:topDataProperty ;
                                    rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneDefectosNoPulpa
table-olives-ontology:tieneDefectosNoPulpa rdf:type owl:DatatypeProperty ;
                                           rdfs:subPropertyOf table-olives-ontology:tieneDefectos ;
                                           rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneDefectosPulpa
table-olives-ontology:tieneDefectosPulpa rdf:type owl:DatatypeProperty ;
                                         rdfs:subPropertyOf table-olives-ontology:tieneDefectos ;
                                         rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneFrutosArrugados
table-olives-ontology:tieneFrutosArrugados rdf:type owl:DatatypeProperty ;
                                           rdfs:subPropertyOf table-olives-ontology:tieneDefectos ;
                                           rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneFrutosBlandos
table-olives-ontology:tieneFrutosBlandos rdf:type owl:DatatypeProperty ;
                                         rdfs:subPropertyOf table-olives-ontology:tieneDefectos ;
                                         rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tieneNumAceitunas
table-olives-ontology:tieneNumAceitunas rdf:type owl:DatatypeProperty ;
                                        rdfs:subPropertyOf owl:topDataProperty ;
                                        rdfs:domain table-olives-ontology:Calibrado ;
                                        rdfs:range xsd:positiveInteger .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tienePorcentajeAccidez
table-olives-ontology:tienePorcentajeAccidez rdf:type owl:DatatypeProperty ;
                                             rdfs:subPropertyOf owl:topDataProperty ;
                                             rdfs:range xsd:double .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tienePorcentajeConcentracionSalina
table-olives-ontology:tienePorcentajeConcentracionSalina rdf:type owl:DatatypeProperty ;
                                                         rdfs:subPropertyOf owl:topDataProperty ;
                                                         rdfs:range xsd:integer .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#tiene_pH
table-olives-ontology:tiene_pH rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf owl:topDataProperty ;
                               rdfs:range xsd:double .


###  http://www.w3.org/2002/07/owl#topDataProperty
owl:topDataProperty rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Accidez_Salmuera
table-olives-ontology:Accidez_Salmuera rdf:type owl:Class ;
                                       owl:equivalentClass [ owl:intersectionOf ( table-olives-ontology:Factores_Calidad_Salmuera
                                                                                  [ rdf:type owl:Restriction ;
                                                                                    owl:onProperty table-olives-ontology:tienePorcentajeAccidez ;
                                                                                    owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                        owl:onDatatype xsd:double ;
                                                                                                        owl:withRestrictions ( [ xsd:minInclusive "0.4"^^xsd:double
                                                                                                                               ]
                                                                                                                             )
                                                                                                      ]
                                                                                  ]
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ] ;
                                       rdfs:label "Accidez mínima salmuera"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Colocada
table-olives-ontology:Aceituna_Colocada rdf:type owl:Class ;
                                        rdfs:subClassOf table-olives-ontology:Presentacion_Aceituna ;
                                        rdfs:comment "En envases rígidos transparentes y guardando un orden simétrico o adoptando formas geométricas." ;
                                        rdfs:label "Aceituna colocada"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante
table-olives-ontology:Aceituna_Color_Cambiante rdf:type owl:Class ;
                                               owl:equivalentClass [ owl:intersectionOf ( table-olives-ontology:Tipo_Aceituna
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty table-olives-ontology:tieneColor ;
                                                                                            owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                 owl:unionOf ( table-olives-ontology:Rosa_Vinoso
                                                                                                                               table-olives-ontology:Rosado
                                                                                                                             )
                                                                                                               ]
                                                                                          ]
                                                                                          [ rdf:type owl:Restriction ;
                                                                                            owl:onProperty table-olives-ontology:tieneEtapaRecogida ;
                                                                                            owl:someValuesFrom table-olives-ontology:Envero
                                                                                          ]
                                                                                        ) ;
                                                                     rdf:type owl:Class
                                                                   ] ;
                                               table-olives-ontology:synonym "Aceituna Pintona" ,
                                                                             "Aceituna de Envero" ;
                                               rdfs:label "Aceituna de color cambiante"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Aderezada
table-olives-ontology:Aceituna_Color_Cambiante_Aderezada rdf:type owl:Class ;
                                                         rdfs:subClassOf table-olives-ontology:Aceituna_Color_Cambiante_Comercial ,
                                                                         [ rdf:type owl:Class ;
                                                                           owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                                  owl:onProperty table-olives-ontology:tieneTipoConservacion ;
                                                                                                                  owl:someValuesFrom table-olives-ontology:Conservacion_en_Salmuera
                                                                                                                ]
                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                  owl:onProperty table-olives-ontology:tieneTipoConservacion ;
                                                                                                                  owl:someValuesFrom table-olives-ontology:Conservacion_por_Calor
                                                                                                                ]
                                                                                                              ) ;
                                                                                           rdf:type owl:Class
                                                                                         ]
                                                                                         [ rdf:type owl:Restriction ;
                                                                                           owl:onProperty table-olives-ontology:tieneTipoConservacion ;
                                                                                           owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                                                owl:unionOf ( table-olives-ontology:Conservacion_en_Salmuera
                                                                                                                              table-olives-ontology:Conservacion_por_Calor
                                                                                                                            )
                                                                                                              ]
                                                                                         ]
                                                                                       )
                                                                         ] ,
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty table-olives-ontology:tieneTratamiento ;
                                                                           owl:someValuesFrom table-olives-ontology:Tratamiento_con_Lejia_Alcalina
                                                                         ] ;
                                                         rdfs:label "Aceituna color cambiante aderezada"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Comercial
table-olives-ontology:Aceituna_Color_Cambiante_Comercial rdf:type owl:Class ;
                                                         owl:equivalentClass [ owl:intersectionOf ( table-olives-ontology:Categoria_Producto
                                                                                                    [ rdf:type owl:Restriction ;
                                                                                                      owl:onProperty table-olives-ontology:tieneTipoAceituna ;
                                                                                                      owl:someValuesFrom table-olives-ontology:Aceituna_Color_Cambiante
                                                                                                    ]
                                                                                                  ) ;
                                                                               rdf:type owl:Class
                                                                             ] ;
                                                         rdfs:label "Aceituna color cambiante comercial"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Ennegrecida
table-olives-ontology:Aceituna_Color_Cambiante_Ennegrecida rdf:type owl:Class ;
                                                           rdfs:subClassOf table-olives-ontology:Aceituna_Ennegrecida ,
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty table-olives-ontology:tieneTipoAceituna ;
                                                                             owl:someValuesFrom table-olives-ontology:Aceituna_Color_Cambiante
                                                                           ] ;
                                                           rdfs:label "Aceituna color cambiante ennegrecida"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Natural
table-olives-ontology:Aceituna_Color_Cambiante_Natural rdf:type owl:Class ;
                                                       rdfs:subClassOf table-olives-ontology:Aceituna_Color_Cambiante_Comercial ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty table-olives-ontology:tieneTipoConservacion ;
                                                                         owl:someValuesFrom table-olives-ontology:Fermentacion_Natural
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty table-olives-ontology:tieneTratamiento ;
                                                                         owl:someValuesFrom table-olives-ontology:Tratamiento_con_Salmuera
                                                                       ] ;
                                                       rdfs:label "Aceituna color cambiante natural"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Partida
table-olives-ontology:Aceituna_Color_Cambiante_Partida rdf:type owl:Class ;
                                                       rdfs:subClassOf table-olives-ontology:Aceituna_Partida ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty table-olives-ontology:tieneTipoAceituna ;
                                                                         owl:someValuesFrom table-olives-ontology:Aceituna_Color_Cambiante
                                                                       ] ;
                                                       rdfs:label "Aceituna color cambiante partida"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Seccionada
table-olives-ontology:Aceituna_Color_Cambiante_Seccionada rdf:type owl:Class ;
                                                          rdfs:subClassOf table-olives-ontology:Aceituna_Seccionada ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty table-olives-ontology:tieneTipoAceituna ;
                                                                            owl:someValuesFrom table-olives-ontology:Aceituna_Color_Cambiante
                                                                          ] ;
                                                          rdfs:label "Aceituna color cambiante seccionada"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Seccionada_Aderezada
table-olives-ontology:Aceituna_Color_Cambiante_Seccionada_Aderezada rdf:type owl:Class ;
                                                                    rdfs:subClassOf table-olives-ontology:Aceituna_Color_Cambiante_Seccionada ,
                                                                                    [ rdf:type owl:Restriction ;
                                                                                      owl:onProperty table-olives-ontology:tieneTratamiento ;
                                                                                      owl:someValuesFrom table-olives-ontology:Tratamiento_con_Lejia_Alcalina
                                                                                    ] ;
                                                                    rdfs:label "Aceituna color cambiante seccionada aderezada"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Color_Cambiante_Seccionada_Natural
table-olives-ontology:Aceituna_Color_Cambiante_Seccionada_Natural rdf:type owl:Class ;
                                                                  rdfs:subClassOf table-olives-ontology:Aceituna_Color_Cambiante_Seccionada ;
                                                                  rdfs:label "Aceituna color cambiante seccionada natural"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Deshuesada
table-olives-ontology:Aceituna_Deshuesada rdf:type owl:Class ;
                                          rdfs:subClassOf table-olives-ontology:Presentacion_Aceituna ,
                                                          [ rdf:type owl:Class ;
                                                            owl:complementOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty table-olives-ontology:tieneParte ;
                                                                               owl:someValuesFrom table-olives-ontology:Hueso
                                                                             ]
                                                          ] ;
                                          owl:disjointWith table-olives-ontology:Aceituna_Entera ;
                                          rdfs:label "Aceituna deshuesada"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Deshuesada_Entera
table-olives-ontology:Aceituna_Deshuesada_Entera rdf:type owl:Class ;
                                                 rdfs:subClassOf table-olives-ontology:Aceituna_Deshuesada .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Ennegrecida
table-olives-ontology:Aceituna_Ennegrecida rdf:type owl:Class ;
                                           rdfs:subClassOf table-olives-ontology:Categoria_Producto ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty table-olives-ontology:tieneTipoAceituna ;
                                                             owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                  owl:unionOf ( table-olives-ontology:Aceituna_Color_Cambiante
                                                                                                table-olives-ontology:Aceituna_Verde
                                                                                              )
                                                                                ]
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty table-olives-ontology:tieneTipoConservacion ;
                                                             owl:someValuesFrom table-olives-ontology:Esterilizacion
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty table-olives-ontology:tieneTratamiento ;
                                                             owl:someValuesFrom table-olives-ontology:Oxidacion
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty table-olives-ontology:tieneTratamiento ;
                                                             owl:someValuesFrom table-olives-ontology:Tratamiento_con_Lejia_Alcalina
                                                           ] ;
                                           rdfs:label "Aceituna ennegrecida"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Ensalada
table-olives-ontology:Aceituna_Ensalada rdf:type owl:Class ;
                                        rdfs:subClassOf table-olives-ontology:Aceituna_Deshuesada ;
                                        rdfs:label "Aceituna para ensaladas"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Entera
table-olives-ontology:Aceituna_Entera rdf:type owl:Class ;
                                      rdfs:subClassOf table-olives-ontology:Presentacion_Aceituna ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty table-olives-ontology:tieneParte ;
                                                        owl:someValuesFrom table-olives-ontology:Hueso
                                                      ] ;
                                      rdfs:label "Aceituna entera"@es .


###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Aceituna_Entera_con_Pedunculo
table-olives-ontology:Aceituna_Entera_con_Pedunculo rdf:type owl:Class ;
                                                    rdfs:subClassOf table-olives-ontology:Aceituna_Entera ,
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty table-olives-ontology:tieneParte ;
                                                                      owl:someValuesFrom table-olives-ontology:Pedunculo
                                                                    ] ;
