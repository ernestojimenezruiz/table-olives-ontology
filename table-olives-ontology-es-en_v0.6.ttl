###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Defectos_example
table-olives-ontology:Defectos_example rdf:type owl:Class ;
                                       rdfs:subClassOf table-olives-ontology:Tolerancia_Defectos_Estandar ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty table-olives-ontology:tieneDefectos ;
                                                         owl:hasValue 19
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty table-olives-ontology:tieneDefectosNoPulpa ;
                                                         owl:hasValue 9
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty table-olives-ontology:tieneDefectosPulpa ;
                                                         owl:hasValue 10
                                                       ] ;
                                       rdfs:comment "Si razonamos sale como unsatisfiable porque tiene más de 17 defectos" .


