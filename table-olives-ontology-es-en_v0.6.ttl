###  http://krono.act.uji.es/people/Ernesto/table-olives/table-olives-ontology.owl#Contrato_Producto
table-olives-ontology:Contrato_Producto rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty table-olives-ontology:tieneCalibre ;
                                                          owl:someValuesFrom table-olives-ontology:Calibrado
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty table-olives-ontology:tieneCategoria ;
                                                          owl:someValuesFrom table-olives-ontology:Categoria_Producto
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty table-olives-ontology:tienePresentacion ;
                                                          owl:someValuesFrom table-olives-ontology:Presentacion_Aceituna
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty table-olives-ontology:tieneToleranciaDefectos ;
                                                          owl:someValuesFrom table-olives-ontology:Tolerancia_Defectos
                                                        ] ;
                                        rdfs:comment "El contrato del producto especificará las características requeridas de un producto. Si un producto se adapta a sus características, se clasificará como subtipo del contrato." ;
                                        rdfs:label "Contrato Producto"@es .


