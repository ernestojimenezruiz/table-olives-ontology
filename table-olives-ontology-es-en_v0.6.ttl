###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:Restriction ;
  owl:onProperty table-olives-ontology:tieneEtapaRecogida ;
  owl:someValuesFrom table-olives-ontology:Envero ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty table-olives-ontology:tieneColor ;
                    owl:allValuesFrom [ rdf:type owl:Class ;
                                        owl:unionOf ( table-olives-ontology:Rosa_Vinoso
                                                      table-olives-ontology:Rosado
                                                    )
                                      ]
                  ]
] .


[ rdf:type owl:Restriction ;
  owl:onProperty table-olives-ontology:tieneEtapaRecogida ;
  owl:someValuesFrom table-olives-ontology:Envero_Final ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty table-olives-ontology:tieneColor ;
                    owl:allValuesFrom [ rdf:type owl:Class ;
                                        owl:unionOf ( table-olives-ontology:Castaño_Oscuro
                                                      table-olives-ontology:Negro_Rojizo
                                                      table-olives-ontology:Negro_Verdoso
                                                      table-olives-ontology:Negro_Violaceo
                                                      table-olives-ontology:Violeta_Oscuro
                                                    )
                                      ]
                  ]
] .


[ rdf:type owl:Restriction ;
  owl:onProperty table-olives-ontology:tieneEtapaRecogida ;
  owl:someValuesFrom table-olives-ontology:Envero_Inicial ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty table-olives-ontology:tieneColor ;
                    owl:allValuesFrom [ rdf:type owl:Class ;
                                        owl:unionOf ( table-olives-ontology:Amarillo_Paja
                                                      table-olives-ontology:Verde
                                                    )
                                      ]
                  ]
] .


[ rdf:type owl:Restriction ;
  owl:onProperty table-olives-ontology:tieneTipoAceituna ;
  owl:someValuesFrom table-olives-ontology:Aceituna_Verde ;
  rdfs:subClassOf [ rdf:type owl:Restriction ;
                    owl:onProperty table-olives-ontology:tieneColor ;
                    owl:someValuesFrom [ rdf:type owl:Class ;
                                         owl:unionOf ( table-olives-ontology:Amarillo_Paja
                                                       table-olives-ontology:Verde
                                                     )
                                       ]
                  ]
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( table-olives-ontology:Aceituna_Color_Cambiante
                table-olives-ontology:Aceituna_Negra
                table-olives-ontology:Aceituna_Verde
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( table-olives-ontology:Aceituna_Color_Cambiante_Comercial
                table-olives-ontology:Aceituna_Negra_Comercial
                table-olives-ontology:Aceituna_Verde_Comercial
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( table-olives-ontology:Adicion_Conservante
                table-olives-ontology:Conservacion_en_Salmuera
                table-olives-ontology:Conservacion_entre_Capas_Sal_Seca
                table-olives-ontology:Conservacion_por_Calor
                table-olives-ontology:Conservacion_por_Gas_Inerte
                table-olives-ontology:Fermentacion
                table-olives-ontology:Pulverizacion_Sal_Seca
                table-olives-ontology:Refrigeracion
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( table-olives-ontology:Amarillo_Paja
                table-olives-ontology:Castaño_Oscuro
                table-olives-ontology:Negro
                table-olives-ontology:Negro_Rojizo
                table-olives-ontology:Negro_Verdoso
                table-olives-ontology:Negro_Violaceo
                table-olives-ontology:Rosa_Vinoso
                table-olives-ontology:Rosado
                table-olives-ontology:Verde
                table-olives-ontology:Violeta_Oscuro
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( table-olives-ontology:Calibre_101_110
                table-olives-ontology:Calibre_111_120
                table-olives-ontology:Calibre_121_140
                table-olives-ontology:Calibre_141_160
                table-olives-ontology:Calibre_161_180
                table-olives-ontology:Calibre_181_200
